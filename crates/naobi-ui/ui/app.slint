import { ListView } from "std-widgets.slint";
import "../assets/Inter-subset.ttf";
import "../assets/JetBrainsMono-Regular.ttf";

// One list line: a section header or a result row, built from naobi-core::ui::Screen.
export struct Line {
    is-header: bool,
    title: string,
    subtitle: string,
    hint: string,
    label: string,
    selected: bool,
    calculator: bool,
    disabled: bool,
    armed: bool,
    pinned: bool,
    has-swatch: bool,
    swatch: color,
    has-icon: bool,
    icon: image,
    // A drawn icon (SVG path data on a 24 x 24 grid): the outline, and a faint filled region.
    has-glyph: bool,
    glyph: string,
    glyph-region: string,
    // A second, small glyph on the right of the row (the run history mark); empty for none.
    glyph-trailing: string,
    // Row number among the rows (headers have none); what a click reports.
    row: int,
}

export struct ActionLine {
    label: string,
    shortcut: string,
    reason: string,
    selected: bool,
}

// DESIGN_SYSTEM.md tokens. The values come from naobi-core::tokens and are set once at startup.
export global Tokens {
    in-out property <color> surface-window;
    in-out property <color> surface-raised;
    in-out property <color> surface-selected;
    in-out property <color> surface-well;
    in-out property <color> text-primary;
    in-out property <color> subtitle-selected;
    in-out property <color> text-muted;
    in-out property <color> accent;
    in-out property <color> focus;
    in-out property <color> danger;
    in-out property <color> line-hair;
    in-out property <color> line-strong;
    // ui.text_scale: 1.0, 1.125 or 1.25.
    in-out property <float> scale: 1;
    // 0 under reduced motion (Windows "Animation effects" off), 1 otherwise.
    in-out property <float> motion: 1;
}

component Chip inherits Rectangle {
    in property <string> text;
    // True on a selected row or action: the chip text then uses the selected-row subtitle ink
    // (muted ink fails 4.5:1 on the selected wash, see r007 tests).
    in property <bool> on-selected: false;
    height: 20px * Tokens.scale;
    width: chip-text.preferred-width + 8px;
    border-width: 1px;
    border-color: Tokens.line-strong;
    border-radius: 2px;
    chip-text := Text {
        x: 4px;
        y: 2px;
        text: root.text;
        font-size: 12px * Tokens.scale;
        color: root.on-selected ? Tokens.subtitle-selected : Tokens.text-muted;
    }
}

component HeaderItem inherits Rectangle {
    in property <string> text;
    height: 40px * Tokens.scale;
    accessible-role: AccessibleRole.text;
    accessible-label: root.text;
    Text {
        x: 16px;
        y: 12px * Tokens.scale;
        text: root.text;
        font-size: 13px * Tokens.scale;
        font-weight: 500;
        letter-spacing: 0.3px;
        color: Tokens.text-muted;
    }
}

// Dragging it moves the window (the callback gets the pointer's travel since the press).
component DragHandle inherits TouchArea {
    callback moved-by(length, length);
    property <length> from-x;
    property <length> from-y;
    pointer-event(e) => {
        if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
            self.from-x = self.mouse-x;
            self.from-y = self.mouse-y;
        }
    }
    moved => {
        if (self.pressed) {
            root.moved-by(self.mouse-x - self.from-x, self.mouse-y - self.from-y);
        }
    }
}

component ResultRow inherits Rectangle {
    in property <Line> line;
    callback activated();
    // Both carry the pointer's position in the window.
    callback hovered(length, length);
    callback scrolled(length, length);
    height: 40px * Tokens.scale;
    clip: true;
    background: line.selected ? Tokens.surface-selected : transparent;
    accessible-role: AccessibleRole.list-item;
    accessible-label: line.label;
    accessible-item-selectable: true;
    accessible-item-selected: line.selected;
    // Narrator's "invoke" runs the row, like a click.
    accessible-action-default => { root.activated(); }

    if line.selected : Rectangle {
        x: 0;
        width: 2px;
        height: parent.height;
        // A armed row takes the danger bar (paper) or the primary text color (stone).
        background: line.armed ? Tokens.danger : Tokens.accent;
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;
        alignment: start;
        if line.has-icon : Image {
            width: 22px;
            height: 22px;
            y: (parent.height - self.height) / 2;
            source: line.icon;
            image-fit: contain;
        }
        if !line.has-icon && line.has-glyph : Rectangle {
            width: 22px;
            height: 22px;
            y: (parent.height - self.height) / 2;
            Path {
                x: 1px;
                y: 1px;
                width: 20px;
                height: 20px;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: line.glyph-region;
                fill: Tokens.text-primary;
                opacity: 0.35;
            }
            Path {
                x: 1px;
                y: 1px;
                width: 20px;
                height: 20px;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: line.glyph;
                stroke: Tokens.text-primary;
                stroke-width: 1.7px;
                stroke-line-cap: round;
                stroke-line-join: round;
            }
        }
        if !line.has-icon && !line.has-glyph : Rectangle {
            width: 22px;
            height: 22px;
            y: (parent.height - self.height) / 2;
            border-radius: 4px;
            background: line.has-swatch ? line.swatch : Tokens.line-hair;
            border-width: line.has-swatch ? 1px : 0px;
            border-color: Tokens.line-strong;
        }
        Text {
            text: line.title;
            font-size: (line.calculator ? 18px : 13px) * Tokens.scale;
            font-weight: line.calculator ? 500 : 400;
            color: Tokens.text-primary;
            opacity: line.disabled ? 0.38 : 1;
            vertical-alignment: center;
        }
        Text {
            // type.meta: JetBrains Mono.
            text: line.subtitle;
            font-family: "JetBrains Mono";
            font-size: 12px * Tokens.scale;
            color: line.selected ? Tokens.subtitle-selected : Tokens.text-muted;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        Rectangle {
            width: 6px;
            height: 6px;
            y: (parent.height - self.height) / 2;
            border-radius: 3px;
            background: line.pinned ? Tokens.accent : transparent;
        }
        if line.glyph-trailing != "" : Rectangle {
            width: 18px;
            height: 18px;
            y: (parent.height - self.height) / 2;
            Path {
                width: 18px;
                height: 18px;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: line.glyph-trailing;
                stroke: line.selected ? Tokens.subtitle-selected : Tokens.text-muted;
                stroke-width: 1.7px;
                stroke-line-cap: round;
                stroke-line-join: round;
            }
        }
        if line.hint != "" : Chip {
            y: (parent.height - self.height) / 2;
            text: line.hint;
            on-selected: line.selected;
        }
    }
    // A click runs the row, like Enter on it. Last, so it is on top of the row's content.
    TouchArea {
        clicked => { root.activated(); }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.move) {
                root.hovered(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
        // Slint follows a wheel event with a move at the same spot; the window uses this to tell it
        // from real motion. The list does the scrolling.
        scroll-event(e) => {
            root.scrolled(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            return EventResult.reject;
        }
    }
}

// One list position: a header or a row. The role of each kind is constant, so each has its own element.
component LineItem inherits Rectangle {
    in property <Line> line;
    callback activated();
    callback hovered(length, length);
    callback scrolled(length, length);
    height: 40px * Tokens.scale;
    if line.is-header : HeaderItem {
        text: line.title;
    }
    if !line.is-header : ResultRow {
        line: root.line;
        activated => { root.activated(); }
        hovered(x, y) => { root.hovered(x, y); }
        scrolled(x, y) => { root.scrolled(x, y); }
    }
}

component ActionItem inherits Rectangle {
    in property <ActionLine> action;
    height: 32px;
    clip: true;
    background: action.selected ? Tokens.surface-selected : transparent;
    accessible-role: AccessibleRole.list-item;
    accessible-label: action.reason == "" ? action.label : action.label + ", " + action.reason;
    accessible-item-selectable: true;
    accessible-item-selected: action.selected;

    if action.selected : Rectangle {
        x: 0;
        width: 2px;
        height: parent.height;
        background: Tokens.accent;
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;
        Text {
            text: action.label;
            font-size: 13px * Tokens.scale;
            color: Tokens.text-primary;
            opacity: action.reason == "" ? 1 : 0.38;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        if action.reason != "" : Text {
            text: action.reason;
            font-size: 12px * Tokens.scale;
            color: action.selected ? Tokens.subtitle-selected : Tokens.text-muted;
            vertical-alignment: center;
        }
        if action.shortcut != "" : Chip {
            y: (parent.height - self.height) / 2;
            text: action.shortcut;
            on-selected: action.selected;
        }
    }
}

component PreviewPane inherits Rectangle {
    in property <int> kind;
    in property <string> text;
    in property <image> picture;
    horizontal-stretch: 1;
    background: Tokens.surface-well;
    border-radius: 4px;
    clip: true;
    if root.kind == 1 : Text {
        // type.preview: JetBrains Mono.
        x: 12px;
        y: 12px;
        width: parent.width - 24px;
        text: root.text;
        wrap: word-wrap;
        font-family: "JetBrains Mono";
        font-size: 13px * Tokens.scale;
        color: Tokens.text-primary;
    }
    if root.kind == 2 : Image {
        x: 8px;
        y: 8px;
        width: parent.width - 16px;
        height: parent.height - 16px;
        source: root.picture;
        image-fit: contain;
    }
    if root.kind == 4 : Text {
        x: 12px;
        y: 12px;
        width: parent.width - 24px;
        text: root.text;
        wrap: word-wrap;
        font-size: 13px * Tokens.scale;
        color: Tokens.text-muted;
    }
    if root.kind == 5 : Text {
        x: 12px;
        y: 12px;
        text: "Nothing selected";
        font-size: 13px * Tokens.scale;
        color: Tokens.text-muted;
    }
}

export component AppWindow inherits Window {
    title: "Naobi Command Launcher";
    no-frame: true;
    always-on-top: true;
    background: Tokens.surface-window;
    default-font-family: "Inter";

    // Window size is set from Rust (lib.rs resize: 750 x model::frame_height). Nothing in this
    // file sizes the window, so the footer always sits at the bottom edge.
    // Work-area height in logical px, 0 when unknown (no clamp).
    in-out property <float> work-height: 0;
    // False while the window is cloaked: nothing animates then.
    in-out property <bool> active: false;
    in property <[Line]> lines;
    in property <int> selected: 0;
    in-out property <string> query;
    // Line index of the selected row; headers count, so the scroll math is uniform.
    in property <string> count-text;
    in property <string> notice;
    in property <string> footer-primary;
    in property <bool> footer-actions;
    in property <string> footer-secondary;
    in property <string> placeholder;
    in property <string> footer-confirmation;
    in property <bool> loading;
    in property <bool> empty-visible;
    in property <string> empty-title;
    in property <string> empty-helper;
    // 0 no preview, 1 text, 2 image, 3 loading, 4 error, 5 empty.
    in property <int> preview-kind;
    in property <string> preview-text;
    in property <image> preview-image;
    in property <bool> panel-open;
    in-out property <string> panel-filter;
    in property <[ActionLine]> actions;

    callback text-changed(string);
    callback key-pressed(string, bool, bool, bool) -> bool;
    callback row-activated(int);
    callback row-hovered(int);
    // Where the pointer last was over a row: only motion away from it selects, so a list scrolling
    // under a still pointer does not steal the selection.
    property <length> pointer-x;
    property <length> pointer-y;
    // The footer is the handle: dragging it moves the window by this many logical px.
    callback move-by(length, length);
    public function focus-input() { input.focus(); }

    // Keep the selected line inside the viewport.
    changed selected => {
        if (selected < 0) {
            return;
        }
        if (selected * 40px * Tokens.scale < -list.content-y) {
            list.content-y = -selected * 40px * Tokens.scale;
        } else if ((selected + 1) * 40px * Tokens.scale > -list.content-y + list.visible-height) {
            list.content-y = -((selected + 1) * 40px * Tokens.scale - list.visible-height);
        }
    }

    FocusScope {
        capture-key-pressed(e) => {
            // Backspace edits the field while it holds text; Ctrl+X cuts while text is selected.
            if (e.text == Key.Backspace && root.query != "") {
                return reject;
            }
            // Fail-safe: Ctrl+X reaches the core (entry delete) only with an empty field, where no text
            // can be selected. With text in the field it stays in the field (cut, or nothing).
            if (e.modifiers.control && root.query != "" && (e.text == "x" || e.text == "\u{18}")) {
                return reject;
            }
            if (root.key-pressed(e.text, e.modifiers.control, e.modifiers.alt, e.modifiers.shift)) {
                return accept;
            }
            reject
        }
        Rectangle {
            border-width: 1px;
            border-color: Tokens.line-hair;
            VerticalLayout {
                padding: 1px;
                Rectangle {
                    height: 66px;
                    // Behind the field: the strips around it drag the window, the field stays a text field.
                    DragHandle {
                        moved-by(dx, dy) => { root.move-by(dx, dy); }
                    }
                    input := TextInput {
                        x: 16px;
                        y: 15px;
                        width: parent.width - 32px;
                        height: parent.height - 30px;
                        vertical-alignment: center;
                        font-size: 16px * Tokens.scale;
                        color: Tokens.text-primary;
                        single-line: true;
                        accessible-role: AccessibleRole.text-input;
                        accessible-label: "Search";
                        text <=> root.query;
                        edited => { root.text-changed(self.text); }
                    }
                    Text {
                        x: 16px;
                        height: parent.height;
                        vertical-alignment: center;
                        visible: root.query == "";
                        text: root.placeholder;
                        font-size: 16px * Tokens.scale;
                        color: Tokens.text-muted;
                    }
                    if root.loading && Tokens.motion == 0 : Text {
                        x: parent.width - 96px;
                        height: parent.height;
                        vertical-alignment: center;
                        text: "Searching";
                        font-size: 12px * Tokens.scale;
                        color: Tokens.text-muted;
                    }
                    // Polite live region: the result count, and any Notice below.
                    Text {
                        x: 0;
                        y: 0;
                        height: 1px;
                        opacity: 0;
                        text: root.count-text;
                        accessible-role: AccessibleRole.text;
                        accessible-label: root.count-text;
                        accessible-live-region: polite;
                    }
                }
                // Loading bar: a short accent segment sweeping along a track under the field. Reduced
                // motion shows the word instead.
                Rectangle {
                    height: root.loading && Tokens.motion > 0 ? 2px : 0px;
                    background: Tokens.line-hair;
                    clip: true;
                    if root.active && root.loading && Tokens.motion > 0 : Rectangle {
                        property <float> sweep: 0;
                        width: parent.width * 0.3;
                        x: (parent.width * 1.3) * sweep - self.width;
                        background: Tokens.accent;
                        animate sweep { duration: 900ms; iteration-count: -1; easing: ease-in-out; }
                        init => { self.sweep = 1; }
                    }
                }
                Rectangle { height: 1px; background: Tokens.line-hair; }
                if root.notice != "" : Rectangle {
                    // The banner fades in (150 ms); under reduced motion it appears at once.
                    property <float> fade: 0;
                    opacity: self.fade;
                    animate fade { duration: 150ms * Tokens.motion; }
                    init => { self.fade = 1; }
                    height: 36px * Tokens.scale;
                    background: Tokens.surface-raised;
                    accessible-role: AccessibleRole.text;
                    accessible-label: root.notice;
                    accessible-live-region: polite;
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        spacing: 8px;
                        alignment: start;
                        Text {
                            text: "!";
                            font-size: 13px * Tokens.scale;
                            font-weight: 600;
                            color: Tokens.danger;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.notice;
                            font-size: 13px * Tokens.scale;
                            color: Tokens.text-primary;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                    Rectangle { y: parent.height - 1px; height: 1px; background: Tokens.line-strong; }
                }
                HorizontalLayout {
                    vertical-stretch: 1;
                    list := ListView {
                        horizontal-stretch: root.preview-kind == 0 ? 1 : 0;
                        preferred-width: 300px;
                        accessible-role: AccessibleRole.list;
                        accessible-label: "Results";
                        for l[i] in root.lines : LineItem {
                            line: l;
                            activated => { root.row-activated(l.row); }
                            hovered(x, y) => {
                                if (abs(x - root.pointer-x) >= 1px || abs(y - root.pointer-y) >= 1px) {
                                    root.pointer-x = x;
                                    root.pointer-y = y;
                                    root.row-hovered(l.row);
                                }
                            }
                            scrolled(x, y) => {
                                root.pointer-x = x;
                                root.pointer-y = y;
                            }
                        }
                    }
                    if root.preview-kind != 0 : PreviewPane {
                        kind: root.preview-kind;
                        text: root.preview-text;
                        picture: root.preview-image;
                    }
                }
                Rectangle { height: 1px; background: Tokens.line-hair; }
                Rectangle {
                    height: 42px;
                    background: Tokens.surface-raised;
                    DragHandle {
                        moved-by(dx, dy) => { root.move-by(dx, dy); }
                    }
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        spacing: 8px;
                        Text {
                            text: "Naobi Command";
                            font-size: 12px * Tokens.scale;
                            color: Tokens.text-muted;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        if root.footer-confirmation != "" : Text {
                            text: root.footer-confirmation;
                            font-size: 12px * Tokens.scale;
                            color: Tokens.accent;
                            vertical-alignment: center;
                            accessible-role: text;
                        }
                        if root.footer-primary != "" && root.footer-confirmation == "" : HorizontalLayout {
                            spacing: 6px;
                            Chip { y: (parent.height - self.height) / 2; text: "Enter"; }
                            Text {
                                text: root.footer-primary;
                                font-size: 12px * Tokens.scale;
                                color: Tokens.text-muted;
                                vertical-alignment: center;
                            }
                        }
                        if root.footer-secondary != "" && root.footer-confirmation == "" : HorizontalLayout {
                            spacing: 6px;
                            Chip { y: (parent.height - self.height) / 2; text: "Ctrl Enter"; }
                            Text {
                                text: root.footer-secondary;
                                font-size: 12px * Tokens.scale;
                                color: Tokens.text-muted;
                                vertical-alignment: center;
                            }
                        }
                        if root.footer-actions : HorizontalLayout {
                            spacing: 6px;
                            Chip { y: (parent.height - self.height) / 2; text: "Ctrl K"; }
                            Text {
                                text: "Actions";
                                font-size: 12px * Tokens.scale;
                                color: Tokens.text-muted;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
            if root.empty-visible : VerticalLayout {
                x: 0;
                y: 67px * Tokens.scale;
                // Centered in the list area: beside the preview pane when one is shown.
                width: root.preview-kind != 0 ? 300px : parent.width;
                height: parent.height - 110px * Tokens.scale;
                alignment: center;
                spacing: 6px;
                Text {
                    horizontal-alignment: center;
                    text: root.empty-title;
                    font-size: 18px * Tokens.scale;
                    font-weight: 500;
                    color: Tokens.text-primary;
                }
                Text {
                    horizontal-alignment: center;
                    text: root.empty-helper;
                    font-size: 13px * Tokens.scale;
                    color: Tokens.text-muted;
                }
            }
            // Action panel: 120 ms opacity fade and 2 px rise on open; closing is instant (DESIGN_SYSTEM.md).
            // Hidden through `visible`, so its controls leave the accessibility tree while closed.
            Rectangle {
                visible: root.panel-open;
                opacity: root.panel-open ? 1 : 0;
                animate opacity { duration: 120ms * Tokens.motion; }
                width: 320px;
                height: min(260px, 74px + max(1, root.actions.length) * 32px);
                x: parent.width - self.width - 12px;
                y: parent.height - 42px - self.height - 6px + (root.panel-open ? 0px : 2px);
                animate y { duration: 120ms * Tokens.motion; }
                background: Tokens.surface-raised;
                border-width: 1px;
                border-color: Tokens.line-hair;
                border-radius: 4px;
                clip: true;
                // Clicks on the panel stay on the panel, not on the rows under it.
                TouchArea { }
                VerticalLayout {
                    padding: 8px;
                    spacing: 6px;
                    Rectangle {
                        height: 32px;
                        border-radius: 2px;
                        border-width: filter-input.has-focus ? 2px : 1px;
                        border-color: filter-input.has-focus ? Tokens.focus : Tokens.line-hair;
                        filter-input := TextInput {
                            x: 8px;
                            width: parent.width - 16px;
                            height: parent.height;
                            vertical-alignment: center;
                            font-size: 13px * Tokens.scale;
                            color: Tokens.text-primary;
                            single-line: true;
                            accessible-role: AccessibleRole.text-input;
                            accessible-label: "Filter actions";
                            text <=> root.panel-filter;
                        }
                        if root.panel-filter == "" : Text {
                            x: 8px;
                            height: parent.height;
                            vertical-alignment: center;
                            text: "Filter actions";
                            font-size: 13px * Tokens.scale;
                            color: Tokens.text-muted;
                        }
                    }
                    if root.actions.length == 0 : Text {
                        text: "No actions";
                        font-size: 13px * Tokens.scale;
                        color: Tokens.text-muted;
                    }
                    for a in root.actions : ActionItem {
                        action: a;
                    }
                }
            }
        }
    }
}
