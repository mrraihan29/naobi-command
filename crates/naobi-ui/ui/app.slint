import { ScrollView } from "std-widgets.slint";
import "../assets/Inter-subset.ttf";
import "../assets/JetBrainsMono-Regular.ttf";

// A piece of a title; the letters the query matched are strong.
export struct TitleRun {
    text: string,
    strong: bool,
}

// One list line: a section header or a result row, built from naobi-core::ui::Screen.
export struct Line {
    is-header: bool,
    title: string,
    // The title in pieces when the query matched some of it, otherwise empty.
    runs: [TitleRun],
    subtitle: string,
    subtitle-mono: bool,
    // The kind or another short fact at the right edge.
    right: string,
    hint: string,
    label: string,
    selected: bool,
    calculator: bool,
    disabled: bool,
    armed: bool,
    pinned: bool,
    has-swatch: bool,
    swatch: color,
    has-icon: bool,
    icon: image,
    // A drawn icon (SVG path data on a 24 x 24 grid): the outline, and a faint filled region.
    has-glyph: bool,
    glyph: string,
    glyph-region: string,
    // A second, small glyph on the right of the row (the run history mark); empty for none.
    glyph-trailing: string,
    // Row number among the rows (headers have none); what a click reports.
    row: int,
    // Where the line sits in the list, set by naobi-ui::model.
    top: length,
    height: length,
}

export struct ActionLine {
    label: string,
    // One entry per key cap.
    keys: [string],
    reason: string,
    selected: bool,
    glyph: string,
    // A hairline sits above the first action of every group but the first.
    starts-group: bool,
    danger: bool,
}

// One labelled fact under a preview.
export struct FactLine {
    label: string,
    value: string,
}

// DESIGN_SYSTEM.md tokens. The values come from naobi-core::tokens and are set once at startup.
export global Tokens {
    in-out property <color> surface-window;
    in-out property <color> surface-raised;
    in-out property <color> surface-selected;
    in-out property <color> surface-well;
    in-out property <color> text-primary;
    in-out property <color> subtitle-selected;
    in-out property <color> text-muted;
    in-out property <color> accent;
    in-out property <color> focus;
    in-out property <color> danger;
    in-out property <color> line-hair;
    in-out property <color> line-strong;
    // The active Theme's corner radii.
    in-out property <length> radius-row: 2px;
    in-out property <length> radius-chip: 2px;
    in-out property <length> radius-control: 4px;
    // ui.text_scale: 1.0, 1.125 or 1.25.
    in-out property <float> scale: 1;
    // 0 under reduced motion (Windows "Animation effects" off), 1 otherwise.
    in-out property <float> motion: 1;
}

component Chip inherits Rectangle {
    in property <string> text;
    // True on a selected row or action: the chip text then uses the selected-row subtitle ink
    // (muted ink fails 4.5:1 on the selected wash, see r007 tests).
    in property <bool> on-selected: false;
    height: 20px * Tokens.scale;
    width: max(20px * Tokens.scale, chip-text.preferred-width + 10px);
    border-width: 1px;
    border-color: Tokens.line-strong;
    border-radius: Tokens.radius-chip;
    chip-text := Text {
        x: (parent.width - self.width) / 2;
        y: 2px;
        text: root.text;
        font-size: 12px * Tokens.scale;
        color: root.on-selected ? Tokens.subtitle-selected : Tokens.text-muted;
    }
}

component HeaderItem inherits Rectangle {
    in property <string> text;
    accessible-role: AccessibleRole.text;
    accessible-label: root.text;
    Text {
        x: 16px;
        y: parent.height - self.height - 4px;
        height: 20px * Tokens.scale;
        vertical-alignment: center;
        text: root.text;
        font-size: 13px * Tokens.scale;
        font-weight: 500;
        letter-spacing: 0.3px;
        color: Tokens.text-muted;
    }
}

// A footer action: its label, then one key cap per key.
component FooterAction inherits Rectangle {
    in property <string> label;
    in property <string> key-a;
    in property <string> key-b;
    horizontal-stretch: 0;
    width: content.preferred-width;
    content := HorizontalLayout {
        spacing: 3px;
        Text {
            text: root.label;
            font-size: 12px * Tokens.scale;
            font-weight: 500;
            color: Tokens.text-muted;
            vertical-alignment: center;
        }
        Rectangle { width: 3px; }
        Chip { y: (parent.height - self.height) / 2; text: root.key-a; }
        if root.key-b != "" : Chip { y: (parent.height - self.height) / 2; text: root.key-b; }
    }
}

// Names the current view in the search header. In a pushed view it is also the way back.
component ViewMarker inherits Rectangle {
    in property <string> name;
    in property <bool> back;
    callback activated();
    height: 28px;
    width: content.preferred-width;
    border-width: 1px;
    border-color: Tokens.line-strong;
    border-radius: Tokens.radius-chip;
    background: root.back && touch.has-hover ? Tokens.surface-selected : transparent;
    accessible-role: AccessibleRole.button;
    accessible-label: root.back ? "Back" : root.name;
    accessible-enabled: root.back;
    accessible-action-default => {
        if (root.back) {
            root.activated();
        }
    }
    content := HorizontalLayout {
        padding-left: root.back ? 5px : 9px;
        padding-right: 9px;
        spacing: 3px;
        if root.back : Path {
            width: 14px;
            height: 14px;
            y: 7px;
            viewbox-width: 24;
            viewbox-height: 24;
            commands: "M15 6 L9 12 L15 18";
            stroke: Tokens.subtitle-selected;
            stroke-width: 1.7px;
            stroke-line-cap: round;
            stroke-line-join: round;
        }
        Text {
            text: root.name;
            font-size: 12px;
            font-weight: 500;
            color: Tokens.text-primary;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        enabled: root.back;
        clicked => { root.activated(); }
    }
}

// Dragging it moves the window (the callback gets the pointer's travel since the press).
component DragHandle inherits TouchArea {
    callback moved-by(length, length);
    property <length> from-x;
    property <length> from-y;
    pointer-event(e) => {
        if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
            self.from-x = self.mouse-x;
            self.from-y = self.mouse-y;
        }
    }
    moved => {
        if (self.pressed) {
            root.moved-by(self.mouse-x - self.from-x, self.mouse-y - self.from-y);
        }
    }
}

component ResultRow inherits Rectangle {
    in property <Line> line;
    callback activated();
    // Both carry the pointer's position in the window.
    callback hovered(length, length);
    callback scrolled(length, length);
    // The Alt number this row answers to while Alt is held; 0 for none.
    in property <int> cue;
    clip: true;
    border-radius: Tokens.radius-row;
    background: line.selected ? Tokens.surface-selected : transparent;
    accessible-role: AccessibleRole.list-item;
    accessible-label: line.label;
    accessible-item-selectable: true;
    accessible-item-selected: line.selected;
    // Narrator's "invoke" runs the row, like a click.
    accessible-action-default => { root.activated(); }

    if line.selected : Rectangle {
        x: 0;
        width: 2px;
        height: parent.height;
        // A armed row takes the danger bar (paper) or the primary text color (stone).
        background: line.armed ? Tokens.danger : Tokens.accent;
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 14px;
        spacing: 12px;
        if line.has-icon : Image {
            width: 22px;
            height: 22px;
            y: (parent.height - self.height) / 2;
            source: line.icon;
            image-fit: contain;
        }
        if !line.has-icon && line.has-glyph : Rectangle {
            width: 22px;
            height: 22px;
            y: (parent.height - self.height) / 2;
            Path {
                x: 1px;
                y: 1px;
                width: 20px;
                height: 20px;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: line.glyph-region;
                fill: Tokens.text-primary;
                opacity: 0.35;
            }
            Path {
                x: 1px;
                y: 1px;
                width: 20px;
                height: 20px;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: line.glyph;
                stroke: Tokens.text-primary;
                stroke-width: 1.7px;
                stroke-line-cap: round;
                stroke-line-join: round;
            }
        }
        if !line.has-icon && !line.has-glyph : Rectangle {
            width: 22px;
            height: 22px;
            y: (parent.height - self.height) / 2;
            border-radius: 4px;
            background: line.has-swatch ? line.swatch : Tokens.line-hair;
            border-width: line.has-swatch ? 1px : 0px;
            border-color: Tokens.line-strong;
        }
        title-box := Rectangle {
            // A title too long for the row is the plain, elided text.
            property <bool> show-runs: line.runs.length > 0 && title.preferred-width + 6px <= self.width;
            horizontal-stretch: line.subtitle == "" ? 1 : 0;
            min-width: 40px;
            preferred-width: title.preferred-width + (line.runs.length > 0 ? 6px : 0px);
            title := Text {
                width: parent.width;
                height: parent.height;
                visible: !title-box.show-runs;
                text: line.title;
                font-size: (line.calculator ? 18px : 13px) * Tokens.scale;
                font-weight: line.calculator ? 500 : 400;
                color: Tokens.text-primary;
                opacity: line.disabled ? 0.38 : 1;
                vertical-alignment: center;
                overflow: elide;
            }
            if title-box.show-runs : HorizontalLayout {
                alignment: start;
                for run in line.runs : Text {
                    text: run.text;
                    font-size: 13px * Tokens.scale;
                    font-weight: run.strong ? 600 : 400;
                    color: Tokens.text-primary;
                    opacity: line.disabled ? 0.38 : 1;
                    vertical-alignment: center;
                }
            }
        }
        if line.subtitle != "" : Text {
            // type.meta for technical text, type.kind otherwise.
            text: line.subtitle;
            font-family: line.subtitle-mono ? "JetBrains Mono" : "Inter";
            font-size: 12px * Tokens.scale;
            color: line.selected ? Tokens.subtitle-selected : Tokens.text-muted;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        if line.pinned : Rectangle {
            width: 6px;
            height: 6px;
            y: (parent.height - self.height) / 2;
            border-radius: 3px;
            background: Tokens.accent;
        }
        if line.glyph-trailing != "" : Rectangle {
            width: 18px;
            height: 18px;
            y: (parent.height - self.height) / 2;
            Path {
                width: 18px;
                height: 18px;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: line.glyph-trailing;
                stroke: line.selected ? Tokens.subtitle-selected : Tokens.text-muted;
                stroke-width: 1.7px;
                stroke-line-cap: round;
                stroke-line-join: round;
            }
        }
        if root.cue > 0 : Rectangle {
            width: 20px;
            height: 20px;
            y: (parent.height - self.height) / 2;
            border-width: 1px;
            border-color: Tokens.accent;
            border-radius: Tokens.radius-chip;
            Text {
                text: root.cue;
                font-size: 12px * Tokens.scale;
                font-weight: 600;
                color: Tokens.text-primary;
            }
        }
        if root.cue == 0 && line.hint != "" : Chip {
            y: (parent.height - self.height) / 2;
            text: line.hint;
            on-selected: line.selected;
        }
        if root.cue == 0 && line.hint == "" && line.right != "" : Text {
            // type.kind.
            text: line.right;
            font-size: 12px * Tokens.scale;
            color: line.selected ? Tokens.subtitle-selected : Tokens.text-muted;
            vertical-alignment: center;
            min-width: self.preferred-width;
        }
    }
    // A click runs the row, like Enter on it. Last, so it is on top of the row's content.
    TouchArea {
        clicked => { root.activated(); }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.move) {
                root.hovered(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
        // Slint follows a wheel event with a move at the same spot; the window uses this to tell it
        // from real motion. The list does the scrolling.
        scroll-event(e) => {
            root.scrolled(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            return EventResult.reject;
        }
    }
}

// One list position: a header or a row. The role of each kind is constant, so each has its own element.
// Its content exists only near the visible part of the list.
component LineItem inherits Rectangle {
    in property <Line> line;
    in property <bool> near;
    in property <int> cue;
    callback activated();
    callback hovered(length, length);
    callback scrolled(length, length);
    y: line.top;
    height: line.height;
    if root.near && line.is-header : HeaderItem {
        width: parent.width;
        height: parent.height;
        text: line.title;
    }
    if root.near && !line.is-header : ResultRow {
        width: parent.width;
        height: parent.height;
        line: root.line;
        cue: root.cue;
        activated => { root.activated(); }
        hovered(x, y) => { root.hovered(x, y); }
        scrolled(x, y) => { root.scrolled(x, y); }
    }
}

component ActionItem inherits Rectangle {
    in property <ActionLine> action;
    height: action.starts-group ? 41px : 32px;
    accessible-role: AccessibleRole.list-item;
    accessible-label: action.reason == "" ? action.label : action.label + ", " + action.reason;
    accessible-item-selectable: true;
    accessible-item-selected: action.selected;

    if action.starts-group : Rectangle {
        y: 4px;
        height: 1px;
        background: Tokens.line-hair;
    }
    Rectangle {
        y: parent.height - self.height;
        height: 32px;
        clip: true;
        border-radius: Tokens.radius-row;
        background: action.selected ? Tokens.surface-selected : transparent;
        if action.selected : Rectangle {
            x: 0;
            width: 2px;
            height: parent.height;
            background: Tokens.accent;
        }
        HorizontalLayout {
            padding-left: 12px;
            padding-right: 10px;
            spacing: 10px;
            Path {
                width: 16px;
                height: 16px;
                y: (parent.height - self.height) / 2;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: action.glyph;
                stroke: action.danger ? Tokens.danger : Tokens.text-primary;
                stroke-width: 1.8px;
                stroke-line-cap: round;
                stroke-line-join: round;
                opacity: action.reason == "" ? 1 : 0.38;
            }
            Text {
                text: action.label;
                font-size: 13px * Tokens.scale;
                color: action.danger ? Tokens.danger : Tokens.text-primary;
                opacity: action.reason == "" ? 1 : 0.38;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            if action.reason != "" : Text {
                text: action.reason;
                font-size: 12px * Tokens.scale;
                color: action.selected ? Tokens.subtitle-selected : Tokens.text-muted;
                vertical-alignment: center;
            }
            HorizontalLayout {
                spacing: 3px;
                for key in action.keys : Chip {
                    y: (parent.height - self.height) / 2;
                    text: key;
                    on-selected: action.selected;
                }
            }
        }
    }
}

component PreviewPane inherits Rectangle {
    in property <int> kind;
    in property <string> text;
    in property <image> picture;
    in property <[FactLine]> facts;
    property <length> facts-height: root.facts.length == 0 ? 0px : root.facts.length * 20px * Tokens.scale + 19px;
    horizontal-stretch: 1;
    background: Tokens.surface-well;
    border-radius: Tokens.radius-control;
    clip: true;
    Rectangle {
        y: 0;
        height: parent.height - root.facts-height;
        clip: true;
        if root.kind == 1 : Text {
            // type.preview: JetBrains Mono.
            x: 12px;
            y: 12px;
            width: parent.width - 24px;
            text: root.text;
            wrap: word-wrap;
            font-family: "JetBrains Mono";
            font-size: 13px * Tokens.scale;
            color: Tokens.text-primary;
        }
        if root.kind == 2 : Image {
            x: 8px;
            y: 8px;
            width: parent.width - 16px;
            height: parent.height - 16px;
            source: root.picture;
            image-fit: contain;
        }
        if root.kind == 4 : Text {
            x: 12px;
            y: 12px;
            width: parent.width - 24px;
            text: root.text;
            wrap: word-wrap;
            font-size: 13px * Tokens.scale;
            color: Tokens.text-muted;
        }
        if root.kind == 5 : Text {
            x: 12px;
            y: 12px;
            text: "Nothing selected";
            font-size: 13px * Tokens.scale;
            color: Tokens.text-muted;
        }
    }
    if root.facts.length > 0 : Rectangle {
        y: parent.height - root.facts-height;
        height: root.facts-height;
        Rectangle { y: 0; height: 1px; background: Tokens.line-hair; }
        VerticalLayout {
            padding-top: 9px;
            padding-bottom: 10px;
            padding-left: 12px;
            padding-right: 12px;
            for f in root.facts : HorizontalLayout {
                height: 20px * Tokens.scale;
                spacing: 8px;
                Text {
                    width: 82px;
                    text: f.label;
                    font-size: 12px * Tokens.scale;
                    color: Tokens.text-muted;
                    vertical-alignment: center;
                }
                Text {
                    horizontal-stretch: 1;
                    text: f.value;
                    font-size: 12px * Tokens.scale;
                    color: Tokens.text-primary;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "Naobi Command Launcher";
    no-frame: true;
    always-on-top: true;
    background: Tokens.surface-window;
    default-font-family: "Inter";

    // Window size is set from Rust (lib.rs resize: 750 x model::frame_height). Nothing in this
    // file sizes the window, so the footer always sits at the bottom edge.
    // Work-area height in logical px, 0 when unknown (no clamp).
    in-out property <float> work-height: 0;
    // False while the window is cloaked: nothing animates then.
    in-out property <bool> active: false;
    in property <[Line]> lines;
    // Line index of the selected row, and where it sits.
    in property <int> selected: 0;
    in property <length> selected-top;
    in property <length> selected-bottom;
    // Height of all the lines.
    in property <length> lines-height;
    in-out property <string> query;
    in property <string> count-text;
    in property <string> notice;
    in property <string> footer-primary;
    in property <bool> footer-actions;
    in property <string> footer-secondary;
    in property <string> placeholder;
    in property <string> footer-confirmation;
    in property <string> view-name;
    in property <bool> view-marked;
    in property <bool> view-back;
    in property <bool> loading;
    in property <bool> empty-visible;
    in property <string> empty-title;
    in property <string> empty-helper;
    // 0 no preview, 1 text, 2 image, 3 loading, 4 error, 5 empty.
    in property <int> preview-kind;
    in property <string> preview-text;
    in property <image> preview-image;
    in property <[FactLine]> preview-facts;
    in property <bool> panel-open;
    in-out property <string> panel-filter;
    in property <string> panel-title;
    in property <length> panel-height;
    in property <[ActionLine]> actions;
    out property <bool> filter-focused: filter-input.has-focus;
    callback panel-filter-edited(string);

    callback text-changed(string);
    callback key-pressed(string, bool, bool, bool) -> bool;
    callback row-activated(int);
    callback row-hovered(int);
    callback back-activated();
    // Alt shows a number on the first nine visible rows; `cue-base` is the first of them.
    in-out property <bool> alt-held;
    in-out property <int> cue-base;
    out property <length> list-scroll: -list.content-y;
    out property <length> list-height: list.visible-height;
    callback cues-moved();
    changed list-scroll => {
        if (alt-held) {
            cues-moved();
        }
    }
    changed active => {
        if (!active) {
            alt-held = false;
        }
    }
    // While the panel is open the keyboard types into its filter (R-026).
    changed panel-open => {
        if (panel-open) {
            filter-input.focus();
        } else {
            input.focus();
        }
    }
    // Where the pointer last was over a row: only motion away from it selects, so a list scrolling
    // under a still pointer does not steal the selection.
    property <length> pointer-x;
    property <length> pointer-y;
    // The footer is the handle: dragging it moves the window by this many logical px.
    callback move-by(length, length);
    public function focus-input() { input.focus(); }

    // Keep the selected line inside the viewport.
    changed selected => { reveal-selected(); }
    // The selected row also moves when a Theme changes the row height.
    changed selected-bottom => { reveal-selected(); }
    function reveal-selected() {
        if (selected < 0) {
            return;
        }
        if (selected-top < -list.content-y) {
            list.content-y = -selected-top;
        } else if (selected-bottom > -list.content-y + list.visible-height) {
            list.content-y = -(selected-bottom - list.visible-height);
        }
    }
    // A shorter list must not leave the view scrolled past its end.
    changed lines-height => {
        list.content-y = max(list.content-y, min(0px, list.visible-height - lines-height));
    }

    FocusScope {
        capture-key-released(e) => {
            if (e.text == Key.Alt) {
                root.alt-held = false;
            }
            reject
        }
        capture-key-pressed(e) => {
            if (e.text == Key.Alt) {
                root.alt-held = true;
                root.cues-moved();
                return reject;
            }
            // Backspace edits the field while it holds text; Ctrl+X cuts while text is selected.
            if (e.text == Key.Backspace && (root.query != "" || root.panel-filter != "")) {
                return reject;
            }
            // Held down, it stops at the empty field: only a new press leaves the view (R-028).
            if (e.text == Key.Backspace && e.repeat) {
                return accept;
            }
            // Fail-safe: Ctrl+X reaches the core (entry delete) only with an empty field, where no text
            // can be selected. With text in the field it stays in the field (cut, or nothing).
            if (e.modifiers.control && (root.query != "" || root.panel-open) && (e.text == "x" || e.text == "\u{18}")) {
                return reject;
            }
            if (root.key-pressed(e.text, e.modifiers.control, e.modifiers.alt, e.modifiers.shift)) {
                return accept;
            }
            reject
        }
        Rectangle {
            border-width: 1px;
            border-color: Tokens.line-hair;
            VerticalLayout {
                padding: 1px;
                Rectangle {
                    height: 66px;
                    // Behind the field: the strips around it drag the window, the field stays a text field.
                    DragHandle {
                        moved-by(dx, dy) => { root.move-by(dx, dy); }
                    }
                    marker := ViewMarker {
                        x: 16px;
                        y: (parent.height - self.height) / 2;
                        visible: root.view-marked;
                        name: root.view-name;
                        back: root.view-back;
                        activated => { root.back-activated(); }
                    }
                    input := TextInput {
                        x: root.view-marked ? marker.x + marker.width + 10px : 16px;
                        y: 15px;
                        width: parent.width - self.x - 16px;
                        height: parent.height - 30px;
                        vertical-alignment: center;
                        font-size: 16px * Tokens.scale;
                        color: Tokens.text-primary;
                        single-line: true;
                        accessible-role: AccessibleRole.text-input;
                        accessible-label: "Search";
                        text <=> root.query;
                        edited => { root.text-changed(self.text); }
                    }
                    Text {
                        x: input.x;
                        height: parent.height;
                        vertical-alignment: center;
                        visible: root.query == "";
                        text: root.placeholder;
                        font-size: 16px * Tokens.scale;
                        color: Tokens.text-muted;
                    }
                    if root.loading && Tokens.motion == 0 : Text {
                        x: parent.width - 96px;
                        height: parent.height;
                        vertical-alignment: center;
                        text: "Searching";
                        font-size: 12px * Tokens.scale;
                        color: Tokens.text-muted;
                    }
                    // Polite live region: the result count, and any Notice below.
                    Text {
                        x: 0;
                        y: 0;
                        height: 1px;
                        opacity: 0;
                        text: root.count-text;
                        accessible-role: AccessibleRole.text;
                        accessible-label: root.count-text;
                        accessible-live-region: polite;
                    }
                }
                // Loading bar: a short accent segment sweeping along a track under the field. Reduced
                // motion shows the word instead.
                Rectangle {
                    height: root.loading && Tokens.motion > 0 ? 2px : 0px;
                    background: Tokens.line-hair;
                    clip: true;
                    if root.active && root.loading && Tokens.motion > 0 : Rectangle {
                        property <float> sweep: 0;
                        width: parent.width * 0.3;
                        x: (parent.width * 1.3) * sweep - self.width;
                        background: Tokens.accent;
                        animate sweep { duration: 900ms; iteration-count: -1; easing: ease-in-out; }
                        init => { self.sweep = 1; }
                    }
                }
                Rectangle { height: 1px; background: Tokens.line-hair; }
                if root.notice != "" : Rectangle {
                    // The banner fades in (150 ms); under reduced motion it appears at once.
                    property <float> fade: 0;
                    opacity: self.fade;
                    animate fade { duration: 150ms * Tokens.motion; }
                    init => { self.fade = 1; }
                    height: 36px * Tokens.scale;
                    background: Tokens.surface-raised;
                    accessible-role: AccessibleRole.text;
                    accessible-label: root.notice;
                    accessible-live-region: polite;
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        spacing: 8px;
                        alignment: start;
                        Text {
                            text: "!";
                            font-size: 13px * Tokens.scale;
                            font-weight: 600;
                            color: Tokens.danger;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.notice;
                            font-size: 13px * Tokens.scale;
                            color: Tokens.text-primary;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                    Rectangle { y: parent.height - 1px; height: 1px; background: Tokens.line-strong; }
                }
                HorizontalLayout {
                    vertical-stretch: 1;
                    // Lines differ in height, so each is placed exactly. The list holds at most 50 rows.
                    list := ScrollView {
                        horizontal-stretch: root.preview-kind == 0 ? 1 : 0;
                        preferred-width: 300px;
                        content-width: self.visible-width;
                        content-height: root.lines-height;
                        accessible-role: AccessibleRole.list;
                        accessible-label: "Results";
                        for l[i] in root.lines : LineItem {
                            width: list.visible-width;
                            line: l;
                            near: l.top + l.height >= -list.content-y - 80px
                                && l.top <= -list.content-y + list.visible-height + 80px;
                            cue: root.alt-held && !l.is-header && !l.disabled
                                && l.row >= root.cue-base && l.row < root.cue-base + 9
                                && l.top + l.height / 2 >= root.list-scroll
                                && l.top + l.height / 2 <= root.list-scroll + root.list-height
                                ? l.row - root.cue-base + 1 : 0;
                            activated => { root.row-activated(l.row); }
                            hovered(x, y) => {
                                if (abs(x - root.pointer-x) >= 1px || abs(y - root.pointer-y) >= 1px) {
                                    root.pointer-x = x;
                                    root.pointer-y = y;
                                    root.row-hovered(l.row);
                                }
                            }
                            scrolled(x, y) => {
                                root.pointer-x = x;
                                root.pointer-y = y;
                            }
                        }
                    }
                    if root.preview-kind != 0 : HorizontalLayout {
                        horizontal-stretch: 1;
                        padding-top: 8px;
                        padding-bottom: 8px;
                        padding-right: 8px;
                        PreviewPane {
                            kind: root.preview-kind;
                            text: root.preview-text;
                            picture: root.preview-image;
                            facts: root.preview-facts;
                        }
                    }
                }
                Rectangle { height: 1px; background: Tokens.line-hair; }
                Rectangle {
                    height: 42px;
                    background: Tokens.surface-raised;
                    DragHandle {
                        moved-by(dx, dy) => { root.move-by(dx, dy); }
                    }
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 12px;
                        spacing: 14px;
                        Text {
                            text: root.view-name;
                            font-size: 12px * Tokens.scale;
                            color: Tokens.text-muted;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        if root.footer-confirmation != "" : Text {
                            text: root.footer-confirmation;
                            font-size: 12px * Tokens.scale;
                            color: Tokens.accent;
                            vertical-alignment: center;
                            accessible-role: text;
                        }
                        if root.footer-primary != "" && root.footer-confirmation == "" : FooterAction {
                            label: root.footer-primary;
                            key-a: "Enter";
                        }
                        if root.footer-secondary != "" && root.footer-confirmation == "" : FooterAction {
                            label: root.footer-secondary;
                            key-a: "Ctrl";
                            key-b: "Enter";
                        }
                        if root.footer-actions : FooterAction {
                            label: "Actions";
                            key-a: "Ctrl";
                            key-b: "K";
                        }
                    }
                }
            }
            if root.empty-visible : VerticalLayout {
                x: 0;
                y: 67px * Tokens.scale;
                // Centered in the list area: beside the preview pane when one is shown.
                width: root.preview-kind != 0 ? 300px : parent.width;
                height: parent.height - 110px * Tokens.scale;
                alignment: center;
                spacing: 6px;
                Text {
                    horizontal-alignment: center;
                    text: root.empty-title;
                    font-size: 18px * Tokens.scale;
                    font-weight: 500;
                    color: Tokens.text-primary;
                }
                Text {
                    horizontal-alignment: center;
                    text: root.empty-helper;
                    font-size: 13px * Tokens.scale;
                    color: Tokens.text-muted;
                }
            }
            // Action panel: 120 ms opacity fade and 2 px rise on open; closing is instant (DESIGN_SYSTEM.md).
            // Hidden through `visible`, so its controls leave the accessibility tree while closed.
            Rectangle {
                visible: root.panel-open;
                opacity: root.panel-open ? 1 : 0;
                animate opacity { duration: 120ms * Tokens.motion; }
                width: 340px;
                height: min(parent.height - 124px, root.panel-height);
                x: parent.width - self.width - 12px;
                y: parent.height - 42px - self.height - 6px + (root.panel-open ? 0px : 2px);
                animate y { duration: 120ms * Tokens.motion; }
                background: Tokens.surface-raised;
                border-width: 1px;
                border-color: Tokens.line-hair;
                border-radius: Tokens.radius-control;
                clip: true;
                // Clicks on the panel stay on the panel, not on the rows under it.
                TouchArea { }
                VerticalLayout {
                    padding: 1px;
                    HorizontalLayout {
                        height: 29px;
                        padding-left: 12px;
                        padding-right: 12px;
                        Text {
                            text: root.panel-title;
                            font-size: 12px * Tokens.scale;
                            font-weight: 500;
                            color: Tokens.text-muted;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                    VerticalLayout {
                        vertical-stretch: 1;
                        alignment: start;
                        if root.actions.length == 0 : HorizontalLayout {
                            height: 32px;
                            padding-left: 12px;
                            Text {
                                text: "No actions";
                                font-size: 13px * Tokens.scale;
                                color: Tokens.text-muted;
                                vertical-alignment: center;
                            }
                        }
                        for a in root.actions : ActionItem {
                            action: a;
                        }
                    }
                    Rectangle {
                        height: 38px;
                        border-width: filter-input.has-focus ? 2px : 1px;
                        border-color: filter-input.has-focus ? Tokens.focus : Tokens.line-hair;
                        filter-input := TextInput {
                            x: 12px;
                            width: parent.width - 24px;
                            height: parent.height;
                            vertical-alignment: center;
                            font-size: 13px * Tokens.scale;
                            color: Tokens.text-primary;
                            single-line: true;
                            accessible-role: AccessibleRole.text-input;
                            accessible-label: "Filter actions";
                            text <=> root.panel-filter;
                            edited => { root.panel-filter-edited(self.text); }
                        }
                        if root.panel-filter == "" : Text {
                            x: 12px;
                            height: parent.height;
                            vertical-alignment: center;
                            text: "Filter actions";
                            font-size: 13px * Tokens.scale;
                            color: Tokens.text-muted;
                        }
                    }
                }
            }
        }
    }
}
